# 复制为 .env 后填写。不填 .env 也可以用 MOCK_LLM=1 以离线演示模式启动。

# -- 模型（Anthropic Messages API 或兼容端点）--
ANTHROPIC_API_KEY=sk-xxx
# 使用 DeepSeek 等兼容端点时填写；用 Anthropic 官方接口则删掉这一行
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL_ID=your-model-id
# 可选：连续过载（529）时切换的备用模型
# FALLBACK_MODEL_ID=
# 可选：Goal 评估使用的模型，默认与 MODEL_ID 相同
# GOAL_EVALUATOR_MODEL_ID=

# -- 运行 --
# Agent 的工作目录，默认是项目根目录下的 workspace/
# AGENT_WORKDIR=D:\work\some-project
# 端点不支持流式输出时设为 0
# STREAMING=1
# HOST=127.0.0.1
# PORT=8000
# 等待你审批工具调用的秒数
# PERMISSION_TIMEOUT=300

# -- 离线演示：不调用任何模型，按固定剧本跑通整条链路 --
# MOCK_LLM=1
